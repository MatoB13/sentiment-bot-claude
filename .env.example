# --- Anthropic (analytik) ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5

# --- Strike Finance API wallet (Ed25519) ---
# Vygeneruj na https://app.strikefinance.org/api-keys
STRIKE_API_PRIVATE_KEY=
STRIKE_API_PUBLIC_KEY=
STRIKE_BASE_URL=https://api.strikefinance.org
STRIKE_NAS100_SYMBOL=NAS100-USD
STRIKE_NVDA_SYMBOL=NVDA-USD
STRIKE_ADA_SYMBOL=ADA-USD
STRIKE_GOLD_SYMBOL=XAU-USD
STRIKE_WTI_SYMBOL=WTI-USD
STRIKE_NIGHT_SYMBOL=NIGHT-USD

# --- Twitter/X (volitelne, plateny tier) ---
ENABLE_TWITTER=false
TWITTER_BEARER_TOKEN=

# --- Databaza ---
# Na Railway pouzi Postgres plugin - SQLite subor sa straca pri redeployi!
DATABASE_URL=sqlite:///trades.db

# --- Skutocne ZDIELANE pre vsetkych 6 tickerov ---
DRY_RUN=true
MONITOR_INTERVAL_MINUTES=10
# Samostatny (tesnejsi) interval len pre watch_monitor.py - Strike sam chrani
# otvorene pozicie SL/TP bracket orderom v realnom case, toto len castejsie
# kontroluje sledovanu cenovu podmienku (viz watch_monitor.py).
WATCH_INTERVAL_MINUTES=1
POSITION_MAX_HOURS=24
# 13-21 UTC pokryva NYSE cash session (9:30-16:00 ET) v oboch DST stavoch -
# jedina skutocne zdielana (nie per-ticker) hranica, je to fakt o trhovej
# strukture, nie o preferencii jednotliveho assetu.
TRADING_HOURS_START_UTC=13
TRADING_HOURS_END_UTC=21

# --- Kazdy ticker nizsie ma VLASTNU sadu 8 premennych:
# {TICKER}_MIN_CONFIDENCE, {TICKER}_MARGIN_USD, {TICKER}_LEVERAGE,
# {TICKER}_SL_PCT, {TICKER}_TP_PCT, {TICKER}_TRADE_INTERVAL_HOURS,
# {TICKER}_OFF_HOURS_INTERVAL_HOURS, {TICKER}_WEEKEND_INTERVAL_HOURS.
# Pre 24/7 krypto (ADA/NIGHT) su off_hours/weekend defaultne rovnake ako
# trade_interval (ziadne skutocne "off hours" pre ne neexistuju), ale su
# nezavisle nastavitelne rovnako ako pre ostatne (viz assets.py). ---

# ============================== NAS100 (index) ==============================
NAS100_MIN_CONFIDENCE=65
NAS100_MARGIN_USD=100
NAS100_LEVERAGE=40
NAS100_SL_PCT=0.4
NAS100_TP_PCT=0.6
NAS100_TRADE_INTERVAL_HOURS=1
NAS100_OFF_HOURS_INTERVAL_HOURS=2
NAS100_WEEKEND_INTERVAL_HOURS=4

# ============================== NVDA (akcia, POZASTAVENE) ==============================
ENABLE_NVDA=false
NVDA_MIN_CONFIDENCE=65
NVDA_MARGIN_USD=100
NVDA_LEVERAGE=10
NVDA_SL_PCT=1.5
NVDA_TP_PCT=2.25
NVDA_TRADE_INTERVAL_HOURS=1
NVDA_OFF_HOURS_INTERVAL_HOURS=2
NVDA_WEEKEND_INTERVAL_HOURS=4

# ============================== ADA (krypto) ==============================
ENABLE_ADA=true
ADA_MIN_CONFIDENCE=65
ADA_MARGIN_USD=100
ADA_LEVERAGE=6
ADA_SL_PCT=3.5
ADA_TP_PCT=5.25
ADA_TRADE_INTERVAL_HOURS=1
ADA_OFF_HOURS_INTERVAL_HOURS=1
ADA_WEEKEND_INTERVAL_HOURS=1

# ============================== GOLD (komodita) ==============================
# Zamerne pridany ako protivietor k prevazne risk-on smerovaniu NAS100/NVDA/ADA
# (safe-haven, opacna VIX polarita v prompte).
ENABLE_GOLD=true
GOLD_MIN_CONFIDENCE=65
GOLD_MARGIN_USD=100
GOLD_LEVERAGE=20
GOLD_SL_PCT=0.8
GOLD_TP_PCT=1.2
GOLD_TRADE_INTERVAL_HOURS=1
GOLD_OFF_HOURS_INTERVAL_HOURS=2
GOLD_WEEKEND_INTERVAL_HOURS=4

# ============================== WTI (ropa) ==============================
# Pridany 2026-07-31 - vyraznejsie odlisny ticker (OPEC+/geopolitika/dopyt,
# NIE safe-haven ako zlato - viz claude_analyst._ENERGY_MACRO_RULES).
ENABLE_WTI=true
WTI_MIN_CONFIDENCE=65
WTI_MARGIN_USD=100
WTI_LEVERAGE=15
WTI_SL_PCT=1.2
WTI_TP_PCT=1.8
WTI_TRADE_INTERVAL_HOURS=1
WTI_OFF_HOURS_INTERVAL_HOURS=2
WTI_WEEKEND_INTERVAL_HOURS=4

# ============================== NIGHT (krypto, Midnight/Cardano) ==============================
# Pridany 2026-07-31 - vyrazne rizikovejsi/volatilnejsi mlady token (Wanchain
# bridge hack 2026-07-20). NIGHT_LEVERAGE=10 je Strike-ov MAX pre tento symbol.
ENABLE_NIGHT=true
NIGHT_MIN_CONFIDENCE=65
NIGHT_MARGIN_USD=100
NIGHT_LEVERAGE=10
NIGHT_SL_PCT=6.0
NIGHT_TP_PCT=9.0
NIGHT_TRADE_INTERVAL_HOURS=1
NIGHT_OFF_HOURS_INTERVAL_HOURS=1
NIGHT_WEEKEND_INTERVAL_HOURS=1
