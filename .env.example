# --- Anthropic (analytik) ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5

# --- Strike Finance API wallet (Ed25519) ---
# Vygeneruj na https://app.strikefinance.org/api-keys
STRIKE_API_PRIVATE_KEY=
STRIKE_API_PUBLIC_KEY=
STRIKE_BASE_URL=https://api.strikefinance.org
STRIKE_NAS100_SYMBOL=NAS100-USD
STRIKE_NVDA_SYMBOL=NVDA-USD
STRIKE_ADA_SYMBOL=ADA-USD
STRIKE_GOLD_SYMBOL=XAU-USD
STRIKE_WTI_SYMBOL=WTI-USD
STRIKE_NIGHT_SYMBOL=NIGHT-USD
STRIKE_BTC_SYMBOL=BTC-USD
STRIKE_HYPE_SYMBOL=HYPE-USD
STRIKE_SKHYNIX_SYMBOL=SKHYNIX-USD

# --- Twitter/X (volitelne, plateny tier) ---
ENABLE_TWITTER=false
TWITTER_BEARER_TOKEN=

# --- Doplnkove datove zdroje (2026-07-31) - vsetky volitelne, zdarma po
# registracii, nikdy neblokuju cyklus (chybajuci kluc = ta sekcia promptu sa
# len vynecha). Presne cisla/spravy priamo z primarneho zdroja namiesto
# spolahnutia sa na to, ci web_search najde a spravne casovo zaradi rovnaku
# informaciu. ---
# CoinGecko Demo API kluc (volny, bez platobnej karty) - len pre HYPE OHLC
# fallback (viz coingecko_client.py). ODPORUCANE nastavit - anonymny pristup
# z Railway zdielanej cloud IP naraza spolahlivo na 429 Too Many Requests
# (overene naozivo 2026-08-08). Bez kluca HYPE stale funguje (retry + neskodi
# ostatne assety), len menej spolahlivo. Registracia:
# https://www.coingecko.com/en/developers/dashboard
COINGECKO_API_KEY=
# EIA (US Energy Information Administration) - len pre WTI (tyzdenne komercne
# zasoby ropy). Registracia: https://www.eia.gov/opendata/register.php
EIA_API_KEY=
# FRED (St. Louis Fed) - zdielane pre vsetky assety (CPI/Core CPI/Fed funds
# rate). Registracia: https://fredaccount.stlouisfed.org
FRED_API_KEY=
# Marketaux - free tier (~100 req/den), news + sentiment per-asset (viz
# assets.py marketaux_query). Registracia: https://www.marketaux.com
MARKETAUX_API_KEY=

# --- Databaza ---
# Na Railway pouzi Postgres plugin - SQLite subor sa straca pri redeployi!
DATABASE_URL=sqlite:///trades.db

# --- Skutocne ZDIELANE pre vsetkych 9 tickerov ---
DRY_RUN=true
MONITOR_INTERVAL_MINUTES=10
# Samostatny (tesnejsi) interval len pre watch_monitor.py - Strike sam chrani
# otvorene pozicie SL/TP bracket orderom v realnom case, toto len castejsie
# kontroluje sledovanu cenovu podmienku (viz watch_monitor.py).
WATCH_INTERVAL_MINUTES=1
POSITION_MAX_HOURS=24
# Bezpecnostna poistka pri zhluku makro udalosti (FOMC/CPI/NFP - viz
# macro_calendar.py) - max. kolko mimoriadnych "vsetky assety" behov sa spusti
# za poslednu hodinu.
MACRO_EVENT_MAX_TRIGGERS_PER_HOUR=3
# 13-21 UTC pokryva NYSE cash session (9:30-16:00 ET) v oboch DST stavoch -
# zdielany DEFAULT pre vsetky assety okrem SKHYNIX (Korea Exchange, ma vlastnu
# dvojicu SKHYNIX_TRADING_HOURS_START_UTC/END_UTC nizsie v jeho sekcii).
TRADING_HOURS_START_UTC=13
TRADING_HOURS_END_UTC=21

# --- Kazdy ticker nizsie ma VLASTNU sadu 9 premennych:
# {TICKER}_MIN_CONFIDENCE, {TICKER}_MARGIN_USD, {TICKER}_LEVERAGE,
# {TICKER}_LIQUIDATION_CUSHION_MULTIPLE, {TICKER}_SL_PCT, {TICKER}_TP_PCT,
# {TICKER}_TRADE_INTERVAL_HOURS, {TICKER}_OFF_HOURS_INTERVAL_HOURS,
# {TICKER}_WEEKEND_INTERVAL_HOURS.
# Pre 24/7 krypto (ADA/NIGHT) su off_hours/weekend defaultne rovnake ako
# trade_interval (ziadne skutocne "off hours" pre ne neexistuju), ale su
# nezavisle nastavitelne rovnako ako pre ostatne (viz assets.py).
#
# POZOR (2026-08-08): {TICKER}_LEVERAGE uz NEOVPLYVNUJE skutocny position
# sizing - paka sa DOPOCITAVA z {TICKER}_LIQUIDATION_CUSHION_MULTIPLE (defaultne
# 1.5 = teoreticka likvidacia je o 50% dalej od vstupu nez SL) a aktualnej SL
# vzdialenosti danej obchodu, vzdy orezana zhora na skutocny Strike max pre
# danu marzu/tier (viz risk_manager._leverage_from_cushion). Cielom je
# maximalizovat expoziciu pri zachovani bezpecneho odstupu od likvidacie.
# {TICKER}_LEVERAGE ostava len ako historicky/referencny udaj. ---

# ============================== NAS100 (index) ==============================
NAS100_MIN_CONFIDENCE=65
NAS100_MARGIN_USD=100
NAS100_LEVERAGE=40
NAS100_LIQUIDATION_CUSHION_MULTIPLE=1.5
NAS100_SL_PCT=0.4
NAS100_TP_PCT=0.6
NAS100_TRADE_INTERVAL_HOURS=1
NAS100_OFF_HOURS_INTERVAL_HOURS=2
NAS100_WEEKEND_INTERVAL_HOURS=4

# ============================== NVDA (akcia, POZASTAVENE) ==============================
ENABLE_NVDA=false
NVDA_MIN_CONFIDENCE=65
NVDA_MARGIN_USD=100
NVDA_LEVERAGE=10
NVDA_LIQUIDATION_CUSHION_MULTIPLE=1.5
NVDA_SL_PCT=1.5
NVDA_TP_PCT=2.25
NVDA_TRADE_INTERVAL_HOURS=1
NVDA_OFF_HOURS_INTERVAL_HOURS=2
NVDA_WEEKEND_INTERVAL_HOURS=4

# ============================== ADA (krypto) ==============================
ENABLE_ADA=true
ADA_MIN_CONFIDENCE=65
# $50 (znizene z $100 2026-08-08) - viac tickerov teraz zdiela jednu penazenku
# bez koordinacie, viz trade_cycle.py preflight kontrola zostatku.
ADA_MARGIN_USD=50
ADA_LEVERAGE=6
ADA_LIQUIDATION_CUSHION_MULTIPLE=1.5
ADA_SL_PCT=3.5
ADA_TP_PCT=5.25
ADA_TRADE_INTERVAL_HOURS=1
ADA_OFF_HOURS_INTERVAL_HOURS=1
ADA_WEEKEND_INTERVAL_HOURS=1

# ============================== GOLD (komodita) ==============================
# Zamerne pridany ako protivietor k prevazne risk-on smerovaniu NAS100/NVDA/ADA
# (safe-haven, opacna VIX polarita v prompte).
ENABLE_GOLD=true
GOLD_MIN_CONFIDENCE=65
GOLD_MARGIN_USD=100
GOLD_LEVERAGE=20
GOLD_LIQUIDATION_CUSHION_MULTIPLE=1.5
GOLD_SL_PCT=0.8
GOLD_TP_PCT=1.2
GOLD_TRADE_INTERVAL_HOURS=1
GOLD_OFF_HOURS_INTERVAL_HOURS=2
GOLD_WEEKEND_INTERVAL_HOURS=4

# ============================== WTI (ropa) ==============================
# Pridany 2026-07-31 - vyraznejsie odlisny ticker (OPEC+/geopolitika/dopyt,
# NIE safe-haven ako zlato - viz claude_analyst._ENERGY_MACRO_RULES).
ENABLE_WTI=true
WTI_MIN_CONFIDENCE=65
WTI_MARGIN_USD=100
WTI_LEVERAGE=15
WTI_LIQUIDATION_CUSHION_MULTIPLE=1.5
WTI_SL_PCT=1.2
WTI_TP_PCT=1.8
WTI_TRADE_INTERVAL_HOURS=1
WTI_OFF_HOURS_INTERVAL_HOURS=2
WTI_WEEKEND_INTERVAL_HOURS=4

# ============================== NIGHT (krypto, Midnight/Cardano) ==============================
# Pridany 2026-07-31 - vyrazne rizikovejsi/volatilnejsi mlady token (Wanchain
# bridge hack 2026-07-20). NIGHT_LEVERAGE=10 bol Strike-ov MAX pre tento symbol
# (historicka hodnota - paka sa uz pocita z vankusa, viz POZOR vyssie).
ENABLE_NIGHT=true
NIGHT_MIN_CONFIDENCE=65
# $50 (znizene z $100 2026-08-08) - rovnaky dovod ako ADA vyssie.
NIGHT_MARGIN_USD=50
NIGHT_LEVERAGE=10
NIGHT_LIQUIDATION_CUSHION_MULTIPLE=1.5
NIGHT_SL_PCT=6.0
NIGHT_TP_PCT=9.0
NIGHT_TRADE_INTERVAL_HOURS=1
NIGHT_OFF_HOURS_INTERVAL_HOURS=1
NIGHT_WEEKEND_INTERVAL_HOURS=1

# ============================== BTC (krypto, Bitcoin) ==============================
# Pridany 2026-08-06 - najlikvidnejsi/najsledovanejsi market na Strike. SL/TP su
# pociatocny odhad (nizsia volatilita nez ADA/NIGHT, tesnejsie preto) - nie
# empiricky backtestovane, prehodnotit po zozbierani realnych dat.
ENABLE_BTC=true
BTC_MIN_CONFIDENCE=65
BTC_MARGIN_USD=100
BTC_LEVERAGE=10
BTC_LIQUIDATION_CUSHION_MULTIPLE=1.5
BTC_SL_PCT=1.5
BTC_TP_PCT=2.25
BTC_TRADE_INTERVAL_HOURS=1
BTC_OFF_HOURS_INTERVAL_HOURS=1
BTC_WEEKEND_INTERVAL_HOURS=1

# ============================== HYPE (krypto, Hyperliquid) ==============================
# Pridany 2026-08-07 - identifikovany korelacnou analyzou celej Strike ponuky
# ako jeden z 3 najmenej korelovanych assetov (diverzifikacia). POZOR: nie je
# na Binance ani yfinance - OHLC fallback/backfill ide cez CoinGecko
# (coingecko_client.py), include_volume je preto zamerne FALSE. SL/TP/leverage
# su pociatocny odhad, nie empiricky backtestovane.
ENABLE_HYPE=true
HYPE_MIN_CONFIDENCE=65
# $50 (rovnaky dovod ako ADA/NIGHT vyssie).
HYPE_MARGIN_USD=50
HYPE_LEVERAGE=8
HYPE_LIQUIDATION_CUSHION_MULTIPLE=1.5
HYPE_SL_PCT=3.5
HYPE_TP_PCT=5.25
HYPE_TRADE_INTERVAL_HOURS=1
HYPE_OFF_HOURS_INTERVAL_HOURS=1
HYPE_WEEKEND_INTERVAL_HOURS=1

# ============================== SKHYNIX (akcia, Korea Exchange) ==============================
# Pridany 2026-08-07 - druhy z 3 najmenej korelovanych assetov (SK Hynix,
# hlavny dodavatel HBM pamati pre Nvidia AI GPU). JEDINY asset s inou nez
# zdielanou NYSE trhovou strukturou - viz SKHYNIX_TRADING_HOURS_START_UTC/
# END_UTC nizsie (KRX seansa 00:00-06:30 UTC, NIE 13-21 UTC ako ostatne).
# SL/TP/leverage su pociatocny odhad, nie empiricky backtestovane.
ENABLE_SKHYNIX=true
SKHYNIX_MIN_CONFIDENCE=65
# $50 (rovnaky dovod ako ADA/NIGHT/HYPE vyssie).
SKHYNIX_MARGIN_USD=50
SKHYNIX_LEVERAGE=10
SKHYNIX_LIQUIDATION_CUSHION_MULTIPLE=1.5
SKHYNIX_SL_PCT=1.5
SKHYNIX_TP_PCT=2.25
SKHYNIX_TRADE_INTERVAL_HOURS=1
SKHYNIX_OFF_HOURS_INTERVAL_HOURS=2
SKHYNIX_WEEKEND_INTERVAL_HOURS=4
SKHYNIX_TRADING_HOURS_START_UTC=0
SKHYNIX_TRADING_HOURS_END_UTC=7
