# --- Anthropic (analytik) ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5

# --- Strike Finance API wallet (Ed25519) ---
# Vygeneruj na https://app.strikefinance.org/api-keys
STRIKE_API_PRIVATE_KEY=
STRIKE_API_PUBLIC_KEY=
STRIKE_BASE_URL=https://api.strikefinance.org
# Zisti presny symbol/asset identifikator pre kazdy market cez strike_client.get_markets()
STRIKE_NAS100_SYMBOL=NAS100-USD
STRIKE_NVDA_SYMBOL=NVDA-USD
STRIKE_ADA_SYMBOL=ADA-USD
STRIKE_GOLD_SYMBOL=XAU-USD
STRIKE_WTI_SYMBOL=WTI-USD
STRIKE_NIGHT_SYMBOL=NIGHT-USD

# --- Twitter/X (volitelne, plateny tier) ---
ENABLE_TWITTER=false
TWITTER_BEARER_TOKEN=

# --- Databaza ---
# Na Railway pouzi Postgres plugin - SQLite subor sa straca pri redeployi!
DATABASE_URL=sqlite:///trades.db

# --- Trading / risk parametre - ZDIELANE pre vsetky assety (NAS100/NVDA/ADA/GOLD/WTI/NIGHT bezia v tom istom cykle) ---
DRY_RUN=true
TRADE_INTERVAL_HOURS=4
MONITOR_INTERVAL_MINUTES=10
# Samostatny (tesnejsi) interval len pre watch_monitor.py (kontrola cenovej
# podmienky) - Strike sam chrani otvorene pozicie SL/TP bracket orderom v
# realnom case, takze MONITOR_INTERVAL_MINUTES pre position_monitor nemusi
# byt tesny, ale watch podmienka sa oplati kontrolovat castejsie.
WATCH_INTERVAL_MINUTES=1
POSITION_MAX_HOURS=24

# --- Variabilny interval - default hodnoty pouzite ak konkretny ticker nema
# vlastnu *_TRADE_INTERVAL_HOURS/*_OFF_HOURS_INTERVAL_HOURS/*_WEEKEND_INTERVAL_HOURS
# premennu nastavenu (viz sekcia "Frekvencia dotazovania PER TICKER" nizsie). ---
OFF_HOURS_INTERVAL_HOURS=2
WEEKEND_INTERVAL_HOURS=6
# 13-21 UTC pokryva NYSE cash session (9:30-16:00 ET) v oboch DST stavoch
TRADING_HOURS_START_UTC=13
TRADING_HOURS_END_UTC=21

# --- NAS100 - risk parametre (povodne, bezpredponove nazvy) ---
MIN_CONFIDENCE=65
# Fixny margin+leverage na kazdy obchod (notional = MARGIN_USD x LEVERAGE)
MARGIN_USD=100
LEVERAGE=40
# Cielove SL/TP ako % od live ceny - Claude navrhuje konkretnu cenu v tolerancii okolo tychto hodnot
DEFAULT_SL_PCT=0.4
DEFAULT_TP_PCT=0.6

# --- NVDA (akcia) - vlastny bot, zapnutelny/vypnutelny, vlastny risk (vyssia
# volatilita ako index -> sirsie SL/TP, nizsia paka) ---
ENABLE_NVDA=true
NVDA_MIN_CONFIDENCE=65
NVDA_MARGIN_USD=100
NVDA_LEVERAGE=10
NVDA_SL_PCT=1.5
NVDA_TP_PCT=2.25

# --- ADA (krypto) - vlastny bot, vlastny risk (najvyssia volatilita -> najsirsie
# SL/TP, najnizsia paka) ---
ENABLE_ADA=true
ADA_MIN_CONFIDENCE=65
ADA_MARGIN_USD=100
ADA_LEVERAGE=6
ADA_SL_PCT=3.5
ADA_TP_PCT=5.25

# --- GOLD (komodita) - vlastny bot, zamerne pridany ako protivietor k prevazne
# risk-on smerovaniu NAS100/NVDA/ADA (safe-haven, opacna VIX polarita v prompte).
# Menej volatilne nez NVDA/ADA, ale volatilnejsie nez index -> paka medzi NAS100 a NVDA ---
ENABLE_GOLD=true
GOLD_MIN_CONFIDENCE=65
GOLD_MARGIN_USD=100
GOLD_LEVERAGE=20
GOLD_SL_PCT=0.8
GOLD_TP_PCT=1.2

# --- WTI (ropa) - vlastny bot, pridany 2026-07-31 ako vyraznejsie odlisny
# ticker (iny driver nez NAS100/ADA/GOLD - OPEC+/geopolitika/dopyt, NIE
# safe-haven ako zlato). Hodnoty su pociatocny odhad, prehodnotit po zozbierani
# realnych dat, rovnako ako povodne NVDA/ADA/GOLD. ---
ENABLE_WTI=true
WTI_MIN_CONFIDENCE=65
WTI_MARGIN_USD=100
WTI_LEVERAGE=15
WTI_SL_PCT=1.2
WTI_TP_PCT=1.8

# --- NIGHT (krypto, Midnight/Cardano) - vlastny bot, pridany 2026-07-31.
# Vyrazne rizikovejsi/volatilnejsi mladý token (nedavny Wanchain bridge hack
# 2026-07-20, ~97% rezerv mostu odcerpanych, cena na historickom minime) ->
# zamerne najnizsia paka a najsirsie SL/TP zo vsetkych assetov. ---
ENABLE_NIGHT=true
NIGHT_MIN_CONFIDENCE=65
NIGHT_MARGIN_USD=100
NIGHT_LEVERAGE=3
NIGHT_SL_PCT=6.0
NIGHT_TP_PCT=9.0

# --- Frekvencia dotazovania PER TICKER (2026-07-31) - kazdy ticker ma teraz
# VLASTNU trojicu (predtym zdielane globalne OFF_HOURS_INTERVAL_HOURS/
# WEEKEND_INTERVAL_HOURS vyssie rovnako pre vsetky variable_interval assety).
# Ak niektoru z nich vynechas, spadne na hodnotu podla assets.py (NAS100/NVDA/
# GOLD/WTI defaultne na TRADE_INTERVAL_HOURS/OFF_HOURS_INTERVAL_HOURS/
# WEEKEND_INTERVAL_HOURS vyssie; WTI navyse defaultne na GOLD_*, NIGHT na ADA_*).
# ADA/NIGHT su 24/7 krypto - maju len TRADE_INTERVAL_HOURS (off_hours/weekend sa
# nepouzivaju, viz assets.py variable_interval=False). ---
NAS100_TRADE_INTERVAL_HOURS=
NAS100_OFF_HOURS_INTERVAL_HOURS=
NAS100_WEEKEND_INTERVAL_HOURS=

NVDA_TRADE_INTERVAL_HOURS=
NVDA_OFF_HOURS_INTERVAL_HOURS=
NVDA_WEEKEND_INTERVAL_HOURS=

ADA_TRADE_INTERVAL_HOURS=

GOLD_TRADE_INTERVAL_HOURS=
GOLD_OFF_HOURS_INTERVAL_HOURS=
GOLD_WEEKEND_INTERVAL_HOURS=

WTI_TRADE_INTERVAL_HOURS=
WTI_OFF_HOURS_INTERVAL_HOURS=
WTI_WEEKEND_INTERVAL_HOURS=

NIGHT_TRADE_INTERVAL_HOURS=
